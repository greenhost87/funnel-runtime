{
  "name": "funnel-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "typecheck": "bun --bun next typegen && tsc --noEmit",
    "fmt": "oxfmt --ignore-path .oxfmtignore",
    "fmt:check": "oxfmt --check --ignore-path .oxfmtignore",
    "migrate": "NODE_ENV=production bun run scripts/migrate.ts",
    "test": "bun test",
    "test:e2e": "bun run scripts/run-e2e.ts",
    "generate:traffic": "bun run scripts/generate-traffic.ts"
  },
  "dependencies": {
    "bulma": "^1.0.4",
    "bulma-calendar-js": "^7.1.2",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "sass": "^1.92.1",
    "typescript": "^5.9.2",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/bun": "^1.2.21",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "oxfmt": "^0.63.0"
  },
  "packageManager": "bun@1.4.0"
}
