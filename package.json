{
  "name": "funnel-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "typecheck": "bun --bun next typegen && tsc --noEmit",
    "fmt": "oxfmt --ignore-path .oxfmtignore",
    "fmt:check": "oxfmt --check --ignore-path .oxfmtignore",
    "migrate": "NODE_ENV=production bun run scripts/migrate.ts",
    "test": "bun test",
    "test:e2e": "bun run scripts/run-e2e.ts",
    "generate:traffic": "bun run scripts/generate-traffic.ts"
  },
  "dependencies": {
    "bulma": "^1.0.4",
    "bulma-calendar-js": "^7.1.2",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "sass": "^1.103.1",
    "typescript": "^5.9.3",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "oxfmt": "^0.63.0"
  },
  "packageManager": "bun@1.4.0"
}
